    <description>在捣药台研磨、调和并直接制成5枚暖脉丹，无需丹炉。</description>
    <jobString>正在捣制暖脉丹。</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RM_AxoPeachWood</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_AxoPeachWood</li>
        <li>MedicineHerbal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MX_WarmingPill>5</MX_WarmingPill>
    </products>
    <recipeUsers>
      <li>Axolotl_GrindingTable</li>
    </recipeUsers>
    <researchPrerequisite>Axolotl_Research_BasePlant</researchPrerequisite>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
  </RecipeDef>
