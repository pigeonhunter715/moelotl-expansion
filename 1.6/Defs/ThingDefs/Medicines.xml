      <li Class="CompProperties_Usable"><compClass>MoeLotlExpansion.CompUsableMedicine</compClass><useJob>UseItem</useJob><useLabel>服用 {0}</useLabel><useDuration>100</useDuration></li>
    </comps>
    <modExtensions><li Class="MoeLotlExpansion.MedicineExtension"><effect>MX_WarmingEffect</effect><durationTicks>120000</durationTicks></li></modExtensions>
  </ThingDef>
