    <healthAffectsPrice>true</healthAffectsPrice>
    <tradeability>All</tradeability>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <stackLimit>25</stackLimit>
    <pathCost>15</pathCost>
    <drawGUIOverlay>true</drawGUIOverlay>
    <statBases><MaxHitPoints>50</MaxHitPoints><Mass>0.05</Mass><MarketValue>12</MarketValue><DeteriorationRate>1</DeteriorationRate><Flammability>0.5</Flammability></statBases>
    <graphicData><texPath>Axolotl_Item/Axolotl_LotlqiPellet</texPath><graphicClass>Graphic_Single</graphicClass><color>(0.72,0.29,0.18)</color><drawSize>(0.65,0.65)</drawSize></graphicData>
