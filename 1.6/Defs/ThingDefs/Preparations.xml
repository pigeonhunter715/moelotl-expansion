<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>MX_RecoveryPreparation</defName>
    <label>回气丹剂</label>
    <description>在捣药台配制。集齐5份投入通天鼎或通天仪，炼成50枚回气丹；丹剂不可直接服用。</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <rotatable>false</rotatable>
    <drawerType>MapMeshOnly</drawerType>
    <healthAffectsPrice>true</healthAffectsPrice>
    <tradeability>All</tradeability>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <stackLimit>25</stackLimit>
    <pathCost>15</pathCost>
    <drawGUIOverlay>true</drawGUIOverlay>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>0.6</Mass>
      <MarketValue>360</MarketValue>
      <DeteriorationRate>1</DeteriorationRate>
      <Flammability>0.5</Flammability>
    </statBases>
    <graphicData>
      <texPath>Axolotl_Item/Axolotl_Ingredient</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <thingCategories>
      <li>Axolotl_Speical</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
